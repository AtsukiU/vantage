# 銘柄詳細ページの「投資委員会の議論」機能(任意)に必要です。
# https://console.anthropic.com/ で取得したAPIキーを設定してください。
# 未設定でもアプリの他の機能(スクリーニング・ポートフォリオ・シミュレーター等)は
# すべて問題なく動作します。
ANTHROPIC_API_KEY=sk-ant-...

# 省略可: 投資委員会の議論生成に使うモデルを変更したい場合(デフォルト: claude-haiku-4-5)
# CLAUDE_COMMITTEE_MODEL=claude-sonnet-5

# 以下2つはRenderなどにデプロイして複数端末から使う場合のみ必要です。
# ローカルで npm run dev するだけなら未設定のままでOK(fs/localStorageで今まで通り動きます)。

# Upstash(https://console.upstash.com/)で作成したRedis DBのREST URL/TOKEN。
# ポートフォリオ・ウォッチリスト・本日の注目銘柄などのデータを端末をまたいで同期するために使う。
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# 公開URLとしてデプロイする際の簡易パスワードゲート。設定すると、このパスワードを
# 知っている人だけがアプリにアクセスできるようになる(未設定ならゲートなし)。
# APP_PASSWORD=your-own-password

# Renderなど一部のホスティングだと、Yahoo Financeの財務データ(PER/PBR/ROEなど)が
# 200 OKなのに中身が空、という形でブロックされることがある。その場合はyahoo-proxy/を
# Vercel(無料)に別プロジェクトとしてデプロイし、そのURLをここに設定すると、
# Yahoo Financeへのアクセスだけそちら経由になる(未設定ならこれまで通り直接アクセスする)。
# YAHOO_PROXY_URL=https://xxxx.vercel.app/api/y
