# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.nodejs
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ただし.env.local.exampleは実際の秘密情報を含まないテンプレートなので、
# セットアップ手順として追跡する(上のパターンから明示的に除外する)。
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本日の注目銘柄(全銘柄バッチスキャン)のキャッシュ結果。日次で再生成されるため追跡しない
/.data/

# デザイン検討用のスクラッチHTML(本番コードではない)
/scratchpad/
